    {"path":"/api/v1/properties/{property_id}/tags","methods":["POST"],"processor":"PropertyTagAPIProcessor","resource":"property_tags","auth":"token"},
    {"path":"/api/v1/property-tags","methods":["GET","POST"],"processor":"cAPI_Processor","resource":"property_tags","auth":"token"},
    {"path":"/api/v1/property-tags/{id}","methods":["GET","PUT","PATCH","DELETE"],"processor":"cAPI_Processor","resource":"property_tags","auth":"token"},
    {"path":"/api/v1/properties/{property_id}/analyses","methods":["POST"],"processor":"PropertyAnalysisAPIProcessor","resource":"analysis_jobs","auth":"user"},
    {"path":"/api/v1/properties/{property_id}/analyses/{type}","methods":["GET","DELETE"],"processor":"PropertyAnalysisResultAPIProcessor","resource":"analyses","auth":"user"},
    {"path":"/api/v1/properties/{property_id}/prices","methods":["GET","POST"],"processor":"PropertyPriceAPIProcessor","resource":"analyses","auth":"user","body_optional":true},
    {"path":"/api/v1/settings","methods":["GET","PATCH"],"processor":"SettingsAPIProcessor","auth":"user"},
    {"path":"/api/v1/me","methods":["GET"],"processor":"MeAPIProcessor","auth":"session"},
