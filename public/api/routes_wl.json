{
  "resources": {
    "properties": {"table":"properties","primary_key":"id","writable":["id","visibility","source","source_url","title","location","address","price","price_text","surface","surface_text","rooms","bedrooms","terrain","dpe","ges","description","image_url","images_json","features_json","coords_json","agency","price_reduction","photo_count","raw_json","captured_at","scraped_at"]},
