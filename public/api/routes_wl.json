    {"path":"/api/v1/analyses/{id}","methods":["GET","PUT","PATCH","DELETE"],"processor":"cAPI_Processor","resource":"analyses","auth":"token"},
    {"path":"/api/v1/analysis-jobs","methods":["GET","POST"],"processor":"cAPI_Processor","resource":"analysis_jobs","auth":"token"},
    {"path":"/api/v1/analysis-jobs/{id}","methods":["GET","PUT","PATCH","DELETE"],"processor":"cAPI_Processor","resource":"analysis_jobs","auth":"token"},
    {"path":"/api/v1/tokens","methods":["GET","POST"],"processor":"TokenAPIProcessor","resource":"api_tokens","auth":"session"}
  ]
