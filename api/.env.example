export IMMO_API_KEY=''
export OPENAI_API_KEY=''
export OPENAI_MODEL='gpt-5.3-chat-latest'
export PERPLEXITY_API_KEY=''

# Binaire PHP CLI utilisé pour lancer le worker d'analyse depuis le serveur web.
# Laisser vide pour utiliser /usr/bin/php.
export SIGMAIMMO_PHP_CLI=''

# Chemin du fichier SQLite applicatif.
# Laisser vide pour utiliser le défaut du code : storage/app.sqlite à la racine du projet.
# En production, préférer un chemin absolu, par exemple /var/www/sigmaimmo/storage/app.sqlite.
export SIGMAIMMO_SQLITE_PATH=''
