<div class="auth-shell">
  <aside class="auth-aside">
    <div class="auth-brand">{{brand}}</div>
    <div class="auth-aside-body">
      <div class="auth-aside-eyebrow">Nouveau mot de passe</div>
      <h1 class="auth-aside-title">Dernière étape avant de retrouver votre galerie.</h1>
      <ul class="auth-aside-points">
        <li>Choisissez un mot de passe d'au moins 8 caractères</li>
        <li>Vous serez déconnecté(e) des autres sessions</li>
      </ul>
    </div>
    <div class="auth-aside-foot">{{brand}} · Analyse immobilière</div>
  </aside>
  <main class="auth-main">
    <div class="auth-card">
      {{^success}}
      <a class="auth-back" href="/auth/login.php">← Retour à la connexion</a>
      <div class="auth-card-head">
        <h2 class="auth-title" id="auth-title">{{labels.title}}</h2>
        <p class="auth-subtitle">{{labels.intro}}</p>
      </div>
      {{#has_error}}
      <div class="auth-alert auth-alert-error" role="alert">{{error}}</div>
      {{/has_error}}
      <form method="post" class="auth-form" novalidate aria-labelledby="auth-title">
        <input type="hidden" name="token" value="{{token}}">
        <div class="auth-field">
          <label for="reset-password">{{labels.password}}</label>
          <input id="reset-password" name="password" type="password" required minlength="8" autocomplete="new-password">
        </div>
        <div class="auth-field">
          <label for="reset-password-confirm">{{labels.password_confirm}}</label>
          <input id="reset-password-confirm" name="password_confirm" type="password" required minlength="8" autocomplete="new-password">
        </div>
        <button class="auth-submit" type="submit">{{labels.submit}}</button>
      </form>
      {{/success}}

      {{#success}}
      <div class="auth-result-icon" aria-hidden="true">✓</div>
      <div class="auth-card-head">
        <h2 class="auth-title">{{labels.success_title}}</h2>
        <p class="auth-subtitle">{{labels.success_message}}</p>
      </div>
      <a class="auth-submit auth-submit-link" href="/auth/login.php">{{labels.login_cta}}</a>
      {{/success}}
    </div>
  </main>
</div>
