<div class="auth-shell">
  <aside class="auth-aside">
    <div class="auth-brand">{{brand}}</div>
    <div class="auth-aside-body">
      <div class="auth-aside-eyebrow">Récupération de compte</div>
      <h1 class="auth-aside-title">Ça arrive à tout le monde. Réinitialisez votre accès en un lien.</h1>
      <ul class="auth-aside-points">
        <li>Lien à usage unique, valable 1 heure</li>
        <li>Vos favoris et analyses restent intacts</li>
      </ul>
    </div>
    <div class="auth-aside-foot">{{brand}} · Analyse immobilière</div>
  </aside>
  <main class="auth-main">
    <div class="auth-card">
      <a class="auth-back" href="/auth/login.php">← Retour à la connexion</a>

      {{^submitted}}
      <div class="auth-card-head">
        <h2 class="auth-title" id="auth-title">{{labels.title}}</h2>
        <p class="auth-subtitle">{{labels.intro}}</p>
      </div>
      <form method="post" class="auth-form" novalidate aria-labelledby="auth-title">
        <div class="auth-field">
          <label for="forgot-email">{{labels.email}}</label>
          <input id="forgot-email" name="email" type="email" required autocomplete="email" value="{{email}}">
        </div>
        <button class="auth-submit" type="submit">{{labels.submit}}</button>
      </form>
      {{/submitted}}

      {{#submitted}}
      <div class="auth-result-icon" aria-hidden="true">✓</div>
      <div class="auth-card-head">
        <h2 class="auth-title">{{labels.sent_title}}</h2>
        <p class="auth-subtitle">{{labels.sent_message}}</p>
      </div>
      {{/submitted}}

      <p class="auth-footer">{{labels.login_prompt}} <a href="/auth/login.php">{{labels.login_cta}}</a></p>
    </div>
  </main>
</div>
