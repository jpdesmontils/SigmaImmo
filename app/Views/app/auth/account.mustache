<div class="account-shell">
  <header class="account-header">
    <div>
      <div class="account-eyebrow">Espace personnel</div>
      <h1 class="account-title">{{labels.title}}</h1>
    </div>
    <span class="account-badge">{{labels.connected}}</span>
  </header>

  <section class="account-section" aria-label="Informations du compte">
    <h2 class="account-section-title">Informations du compte</h2>
    <div class="account-panel">
      <div class="account-row">
        <span class="account-row-label">{{labels.email}}</span>
        <strong class="account-row-value">{{email}}</strong>
      </div>
      <div class="account-row">
        <span class="account-row-label">{{labels.plan}}</span>
        <strong class="account-row-value">{{plan}}</strong>
      </div>
      <div class="account-row">
        <span class="account-row-label">{{labels.favorites}}</span>
        <strong class="account-row-value">{{favorites_count}}{{favorites_limit}}</strong>
      </div>
    </div>
  </section>

  <section class="account-section" aria-labelledby="api-tokens-title">
    <h2 class="account-section-title" id="api-tokens-title">Accès développeur — Tokens API</h2>
    <div class="account-panel">
      <div class="account-panel-body">
        {{#has_issued_token}}
        <div class="auth-alert auth-alert-success" role="status">
          <span>Copiez ce token maintenant, il ne sera plus affiché : <code class="account-token-code">{{issued_token}}</code></span>
        </div>
        {{/has_issued_token}}
        <form method="post" class="auth-form">
          <input type="hidden" name="csrf_token" value="{{csrf_token}}">
          <div class="auth-field">
            <label for="token-label">Libellé</label>
            <input id="token-label" name="token_label" maxlength="120" value="Extension Chrome">
          </div>
          <button class="auth-submit" type="submit">Créer un token</button>
        </form>
      </div>
      <ul class="account-token-list">
        {{#tokens}}
        <li>
          <span class="account-token-name">{{label}}</span>
          <span class="account-token-meta">créé le {{created_at}}{{#last_used_at}}, utilisé le {{last_used_at}}{{/last_used_at}}</span>
        </li>
        {{/tokens}}
        {{^tokens}}<li class="account-empty">Aucun token.</li>{{/tokens}}
      </ul>
    </div>
  </section>

  <a class="account-logout" href="/auth/logout.php">{{labels.logout}}</a>
</div>
