<div class="auth-shell">
  <aside class="auth-aside">
    <div class="auth-brand">{{brand}}</div>
    <div class="auth-aside-body">
      <div class="auth-aside-eyebrow">Espace personnel</div>
      <h1 class="auth-aside-title">Pilotez vos investissements immobiliers avec précision.</h1>
      <ul class="auth-aside-points">
        <li>Analyse instantanée de la rentabilité locative</li>
        <li>Comparatifs de marché DVF en temps réel</li>
        <li>Galerie centralisée de vos biens suivis</li>
      </ul>
    </div>
    <div class="auth-aside-foot">{{brand}} · Analyse immobilière</div>
  </aside>
  <main class="auth-main">
    <div class="auth-card">
      <a class="auth-back" href="/app.html">← Retour à la galerie</a>
      <div class="auth-card-head">
        <h2 class="auth-title" id="auth-title">{{labels.title}}</h2>
        <p class="auth-subtitle">Connectez-vous pour accéder à vos biens suivis.</p>
      </div>
      {{#has_error}}
      <div class="auth-alert auth-alert-error" role="alert">{{error}}</div>
      {{/has_error}}
      <form method="post" class="auth-form" novalidate aria-labelledby="auth-title">
        <div class="auth-field">
          <label for="login-email">{{labels.email}}</label>
          <input id="login-email" name="email" type="email" required autocomplete="email" value="{{email}}">
        </div>
        <div class="auth-field">
          <div class="auth-field-row">
            <label for="login-password">{{labels.password}}</label>
            <a class="auth-inline-link" href="/auth/forgot-password.php">Mot de passe oublié ?</a>
          </div>
          <input id="login-password" name="password" type="password" required autocomplete="current-password">
        </div>
        <button class="auth-submit" type="submit">{{labels.submit}}</button>
      </form>
      <p class="auth-footer">{{labels.register_prompt}} <a href="/auth/register.php">{{labels.register_cta}}</a></p>
    </div>
  </main>
</div>
