<section class="price-position" aria-labelledby="auth-title">
  <div class="stitle">Espace personnel</div>
  <h1 id="auth-title">{{labels.title}}</h1>
  {{#has_error}}
  <div class="alerts" role="alert">
    <p class="alert d">{{error}}</p>
  </div>
  {{/has_error}}
  <form method="post">
    <label class="finance-input" for="login-email">
      {{labels.email}}
      <input id="login-email" name="email" type="email" required autocomplete="email" value="{{email}}">
    </label>
    <label class="finance-input" for="login-password">
      {{labels.password}}
      <input id="login-password" name="password" type="password" required autocomplete="current-password">
    </label>
    <div class="recalculate-actions">
      <button type="submit" data-type="submit">{{labels.submit}}</button>
    </div>
  </form>
</section>
<p class="notice">{{labels.register_prompt}} <a href="/auth/register.php">{{labels.register_cta}}</a></p>
