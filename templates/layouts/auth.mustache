<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{page_title}} — {{brand}}</title>
  <style>
    body{font-family:Arial,sans-serif;max-width:520px;margin:48px auto;padding:0 16px;color:#172033}
    label{display:block;margin:14px 0 6px}
    input{box-sizing:border-box;width:100%;padding:10px;border:1px solid #c8d0dc;border-radius:8px}
    button{margin-top:18px;padding:10px 16px;border:0;border-radius:8px;background:#1f6feb;color:white;font-weight:700}
    .error{padding:10px;border-radius:8px;background:#ffe8e8;color:#8a1f1f}
    .success{padding:10px;border-radius:8px;background:#e8f7ed;color:#176a33}
    a{color:#1f6feb}
  </style>
</head>
<body>
{{{content}}}
</body>
</html>
